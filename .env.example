# Copy to .env.local and fill in.

# Optional. Lifts the anonymous 60 requests/hour GitHub API rate limit for the
# release reads behind the download buttons and the changelog.
#
# Releases are read from the public shreejitverma/cryozen-releases repository
# (the product repo stays private), so a token with no scopes is enough and
# anonymous reads work without one.
#
# If the API is unreachable or rate limited nothing breaks: every GitHub call
# falls back to the releases page.
GITHUB_TOKEN=
