{
  "brand": {
    "prose": "CryoZen",
    "id": "cryozen"
  },
  "owner": {
    "org": "cryozenai",
    "legal_holder": null
  },
  "image": "ghcr.io/cryozenai/cryozen",
  "repos": {
    "source": "cryozenai/cryozen",
    "channel": "cryozenai/cryozen-releases",
    "site": "cryozenai/cryozen-web"
  },
  "install": {
    "docker": [
      "git clone https://github.com/cryozenai/cryozen-releases.git",
      "cd cryozen-releases && cp .env.example .env",
      "docker compose up -d"
    ],
    "desktop_port": 7860,
    "docker_port": 7000,
    "data_dirs": {
      "macos": "~/Library/Application Support/CryoZen",
      "windows": "%LOCALAPPDATA%\\CryoZen",
      "linux": "~/.local/share/cryozen"
    }
  },
  "license": {
    "spdx": "LicenseRef-CryoZen",
    "url": null
  },
  "docs_base": null,
  "features": [
    {
      "id": "chat",
      "claim": "Chat with local and hosted models",
      "surfaces": [
        "desktop",
        "docker"
      ]
    },
    {
      "id": "calendar",
      "claim": "Calendar with recurring events",
      "surfaces": [
        "desktop",
        "docker"
      ]
    },
    {
      "id": "deep-research",
      "claim": "Multi-step deep research",
      "surfaces": [
        "desktop",
        "docker"
      ]
    }
  ],
